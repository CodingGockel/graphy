# Full-table query: one row per flowering observation (species x garden x year).
#
# SELECT variable names MUST match the column names configured in FULL_TABLE_COLUMNS.
# The endpoint exposes only the configured columns, in the configured order.
#
# Notes on the data model (PhenObs phenology KG):
#   - An Occurrence (dwc:Occurrence, URI .../Plant/<spec>_<city>_<year>) is one species
#     at one garden in one year; its rdfs:label is the scientific name.
#   - first/last flower day + year come from the structured time triples
#     (time:dayOfYear / time:year) reachable from the first/last flower statement units.
#   - garden + city come from the geoIndexStatementUnit subject (a botanical garden node)
#     and its ro:locatedIn city node; lat/long are wgs84 coordinates on the garden node
#     (stored as both xsd:decimal and xsd:float, so we filter to one to avoid row dups).
#   - flowering duration has no structured numeric triple, only a label like
#     "... with value 77 and unit unitDay", so the number is parsed out of the label.
#   - country is not present in the graph yet; it is left OPTIONAL and resolves to empty.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
PREFIX semunit: <http://example.com/semunit/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX ro: <http://purl.obolibrary.org/obo/RO_>
PREFIX schema: <http://schema.org/>
PREFIX ns1: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?species ?garden ?city ?country ?lat ?long ?year ?firstFlowerDay ?lastFlowerDay ?floweringDuration WHERE {
  ?occ a dwc:Occurrence ; rdfs:label ?species .

  # First flower: day of year + observation year, plus the geo index for garden/city.
  ?firstComplex a semunit:complexStatementUnit ;
                semunit:hasSemanticUnitSubject ?ffStmt ;
                semunit:hasAssociatedSemanticUnit ?geo .
  ?ffStmt a semunit:firstFlowerStatementUnit ;
          semunit:hasSemanticUnitSubject ?occ ;
          time:hasTime/time:inDateTime ?ffDtd .
  ?ffDtd time:dayOfYear ?firstFlowerDay ;
         time:year ?year .

  # Garden + city.
  ?geo a semunit:geoIndexStatementUnit ;
       semunit:hasSemanticUnitSubject ?gardenNode .
  ?gardenNode rdfs:label ?garden .
  # Coordinates live on the garden node twice (decimal + float); pick one to avoid row dups.
  OPTIONAL { ?gardenNode ns1:lat  ?lat  . FILTER(datatype(?lat)  = xsd:decimal) }
  OPTIONAL { ?gardenNode ns1:long ?long . FILTER(datatype(?long) = xsd:decimal) }
  OPTIONAL {
    ?gardenNode ro:locatedIn ?cityNode .
    ?cityNode a schema:City ; rdfs:label ?city .
    OPTIONAL { ?cityNode ro:locatedIn ?countryNode . ?countryNode rdfs:label ?country . }
  }

  # Last flower: day of year.
  ?lastStmt a semunit:lastFlowerStatementUnit ;
            semunit:hasSemanticUnitSubject ?occ ;
            time:hasTime/time:inDateTime ?lfDtd .
  ?lfDtd time:dayOfYear ?lastFlowerDay .

  # Flowering duration parsed from its label ("... with value <N> and unit ...").
  ?durStmt a semunit:floweringDurationStatementUnit ;
           semunit:hasSemanticUnitSubject ?occ ;
           rdfs:label ?durLabel .
  BIND(xsd:integer(STRBEFORE(STRAFTER(?durLabel, "with value "), " and unit")) AS ?floweringDuration)
}
ORDER BY ?species ?year