# Blablador
BLABLADOR_API_KEY=YOUR_SECRET_BLABLADOR_API_KEY
BLABLADOR_BASE_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
BLABLADOR_SPARQL_MODEL=alias-huge
# Sampling controls for the LLM calls (optional; defaults shown).
LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=  # leave unset for no explicit cap
# Stream the tool-loop calls (live reasoning). Blablador drops the closing </think>
# when a request with tools is streamed, which mixes reasoning and answer: keep it off
# there. With another server, try true.
LLM_STREAM_TOOL_LOOP=false

# GraphDB
GRAPHDB_BASE_URL=http://graphdb-lehre.inf-bb.uni-jena.de:32833
GRAPHDB_REPOSITORY=SWEPLARGE
# Timeout in seconds for SPARQL requests (optional; default shown).
SPARQL_TIMEOUT=30

# Promts
SYSTEM_PROMPT_PATH=src/resources/prompts/system_prompt.md

# Full-table endpoint
FULL_TABLE_QUERY_PATH=src/resources/queries/full_table.rq
FULL_TABLE_COLUMNS=["species", "garden", "city", "country", "lat", "long", "year", "firstFlowerDay", "lastFlowerDay", "floweringDuration"]

# Database
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/db

# Chat Service Config
CHAT_HISTORY_DEPTH=3
CHAT_MAX_TOOL_ITERATIONS=5
# Store the model's reasoning with the chat history (optional; default shown).
PERSIST_THINKING=true
# Session titles (optional; defaults shown). Off: the shortened first question is the title.
GENERATE_SESSION_TITLES=true
SESSION_TITLE_TIMEOUT=5

# CORS: JSON list of allowed origins. Empty = same-origin only (production behind
# nginx). For local dev against a separate frontend dev server, add its origin,
# e.g. ["http://localhost:5173"].
CORS_ALLOW_ORIGINS=[]

# NOTE: This file is for LOCAL (non-Docker) backend dev. The full Docker stack is
# configured from the single root .env (see ../.env.example).
