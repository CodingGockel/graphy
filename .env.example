# =============================================================================
# Root environment for the full stack (docker-compose.yml).
# Copy to `.env` and fill in the secrets. `.env` is gitignored — never commit it.
# =============================================================================

# ---- Deploy / networking ----------------------------------------------------
# Host port the public web entrypoint (nginx) listens on.
WEB_PORT=80
# Number of uvicorn workers in the backend container.
UVICORN_WORKERS=1
# Frontend API base. Leave empty to use the relative /api/v1 (proxied by nginx).
# Set an absolute URL only if the frontend must call a backend on another origin.
VITE_API_BASE_URL=

# ---- LLM (Blablador / OpenAI-compatible) ------------------------------------
BLABLADOR_API_KEY=YOUR_SECRET_BLABLADOR_API_KEY
BLABLADOR_BASE_URL=https://api.helmholtz-blablador.fz-juelich.de/v1/
BLABLADOR_SPARQL_MODEL=alias-huge
LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=  # leave unset for no explicit cap

# ---- GraphDB (external — requires the university VPN) ------------------------
GRAPHDB_BASE_URL=http://graphdb-lehre.inf-bb.uni-jena.de:32833
GRAPHDB_REPOSITORY=SWEPLARGE

# ---- Prompts ----------------------------------------------------------------
SYSTEM_PROMPT_PATH=src/resources/prompts/system_prompt.md

# ---- Full-table endpoint ----------------------------------------------------
FULL_TABLE_QUERY_PATH=src/resources/queries/full_table.rq
FULL_TABLE_COLUMNS=["species", "garden", "city", "country", "lat", "long", "year", "firstFlowerDay", "lastFlowerDay", "floweringDuration"]

# ---- Chat service -----------------------------------------------------------
CHAT_HISTORY_DEPTH=3
CHAT_MAX_TOOL_ITERATIONS=5

# ---- CORS -------------------------------------------------------------------
# JSON list of allowed origins. Empty = same-origin only (frontend served by
# nginx in front of the backend). e.g. ["https://app.example.org"]
CORS_ALLOW_ORIGINS=[]

# ---- Database (PostgreSQL) --------------------------------------------------
# These also build the backend's DATABASE_URL in docker-compose.yml.
# CHANGE THESE before any real deployment.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=db
